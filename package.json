{
  "name": "nschess-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Nschess static site and authenticated browser verification harness",
  "scripts": {
    "test:affected": "node scripts/e2e-runner.cjs affected",
    "test:environment": "node scripts/test-environment.cjs",
    "test:full": "npm run test:environment && node scripts/e2e-runner.cjs full --required --environment-preflighted",
    "test:e2e": "npm run test:environment && node scripts/e2e-runner.cjs e2e --required --environment-preflighted",
    "test:visual": "node scripts/e2e-runner.cjs visual",
    "test:board-sizing": "node scripts/board-sizing-regression.js",
    "test:play-layout": "node scripts/play-board-priority-regression.js",
    "test:promotion": "node scripts/promotion-regression.js",
    "test:books": "node scripts/books-regression.js",
    "test:interaction": "node scripts/route-interaction-regression.js",
    "test:multiplayer": "node scripts/multiplayer-regression.js && node scripts/matchmaking-regression.js",
    "test:matchmaking-live": "npm run test:environment && node scripts/e2e-runner.cjs matchmaking --required --environment-preflighted",
    "test:store-preflight": "npm run test:environment && node scripts/store-preflight.cjs --environment-preflighted",
    "test:store-auth-boundary": "npm run test:environment && node scripts/store-auth-boundary-regression.cjs --environment-preflighted",
    "provision:e2e-b": "node scripts/provision-e2e-account.cjs",
    "test:e2e-wallet": "node scripts/provision-e2e-account.cjs --wallet-only",
    "build": "node scripts/build-pages.js"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
