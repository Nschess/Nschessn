# Copy this file to .env.e2e. The real file is ignored by Git.
# Use dedicated test accounts only; never use a personal or production-owner account.
E2E_ENVIRONMENT=staging
E2E_BASE_URL=http://127.0.0.1:4173
# This must point to a dedicated non-production Supabase project. Do not rely
# on SUPABASE_URL or supabase/.temp/project-ref for disposable fixtures.
E2E_SUPABASE_URL=
# Public key only. Never put a service-role/secret key here.
E2E_SUPABASE_ANON_KEY=
E2E_EMAIL=e2e-primary@example.com
E2E_PASSWORD=replace-with-a-dedicated-test-password
E2E_SECOND_EMAIL=e2e-secondary@example.com
E2E_SECOND_PASSWORD=replace-with-a-dedicated-test-password
E2E_REALTIME_ENABLED=1

# Use a low-cost, coin-purchasable catalog item owned by the test account's project.
E2E_PURCHASE_ITEM_ID=
E2E_PURCHASE_ITEM_PRICE=
E2E_FAILURE_ITEM_ID=
E2E_EXPECTED_NAME_STYLE=
E2E_SECOND_EXPECTED_NAME_STYLE=

# When a server-only SUPABASE_SECRET_KEY (or legacy
# SUPABASE_SERVICE_ROLE_KEY) is present in the current process, Store
# preflight automatically resets only the two generated E2E wallets to the
# deterministic test balance. Set to 0 to require an explicit reset command.
E2E_AUTO_RESET_WALLET=1

# Full CI runs should set this to 1. Local guest/visual smoke tests can leave it 0.
E2E_REQUIRED=0
E2E_HEADLESS=1
E2E_UPDATE_SNAPSHOTS=0
